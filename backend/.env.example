# App
APP_NAME=supply-chain-platform
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supplychain

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ML
MODEL_DIR=saved_models
FORECAST_WINDOW=30
FORECAST_HORIZON=7

# LLM (for weekly NL summaries) -- optional, falls back to a plain-text
# summary if left blank. Set LLM_PROVIDER to "gemini" or "groq" and fill
# in the matching key below.
#   Gemini key: https://aistudio.google.com/app/apikey  (free tier)
#   Groq key:   https://console.groq.com/keys            (free tier)
LLM_PROVIDER=
GEMINI_API_KEY=
GROQ_API_KEY=
