# App
APP_NAME=supply-chain-platform
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supplychain

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ML
MODEL_DIR=saved_models
FORECAST_WINDOW=30
FORECAST_HORIZON=7

# LLM (for weekly NL summaries, PO explanations, & store insights)
# Set LLM_PROVIDER to "gemini" or "groq". Falls back to domain reasoning if blank.
#   Gemini key: https://aistudio.google.com/app/apikey
#   Groq key:   https://console.groq.com/keys
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Transactional Email (Brevo REST API)
# Optional: Stockout alerts and PO notifications gracefully skip or log if blank.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Supply Chain Platform

# Security & CORS
# Comma-separated list of allowed origins in production. In development, localhost is permitted.
CORS_ALLOWED_ORIGINS=

# Logging Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

